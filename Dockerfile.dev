FROM node:24

WORKDIR /app

# Copy manifests only — source is bind-mounted at runtime.
# node_modules is a named volume that overlays the bind mount,
# so packages built here (including better-sqlite3 native bindings)
# are preserved across container restarts.
COPY package*.json ./
COPY packages/shared/package.json ./packages/shared/
COPY apps/backend/package.json ./apps/backend/
COPY apps/portal/package.json ./apps/portal/

RUN npm ci

CMD ["npm", "run", "dev"]
