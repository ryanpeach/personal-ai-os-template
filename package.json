{
  "name": "personal-ai-os",
  "version": "0.0.0",
  "scripts": {
    "prepare": "husky",
    "predev": "supabase start && ./scripts/supabase-backup.sh",
    "dev": "next dev -p 4230 -H 0.0.0.0",
    "build": "next build",
    "start": "next start -p 4230 -H 0.0.0.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "supabase:backup": "./scripts/supabase-backup.sh"
  },
  "private": true,
  "packageManager": "npm@10.9.7",
  "dependencies": {
    "@ionic/react": "^8.8.6",
    "@personal-ai-os/shared": "*",
    "@supabase/supabase-js": "^2.45.4",
    "ionicons": "^8.0.13",
    "next": "^15.1.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.1.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "postcss": "^8.4.38",
    "prettier": "^3.8.1",
    "supabase": "^2.100.1",
    "tailwindcss": "^3.4.4",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
